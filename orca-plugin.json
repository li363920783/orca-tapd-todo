{
  "manifestVersion": 2,
  "id": "tapd-todo",
  "name": "TAPD 待办",
  "version": "0.3.3",
  "description": "在 Orca 右栏查看指派给你的 TAPD 缺陷与需求，筛选、看详情，并一键派给 Orca agent。View TAPD bugs and stories assigned to you in Orca: filter, read details, and dispatch one to an agent.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "tapd",
        "title": "TAPD 待办",
        "icon": "bug",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "statusBarItems": [
      {
        "id": "tapd-pending",
        "icon": "bug",
        "text": "TAPD",
        "tone": "neutral",
        "tooltip": "TAPD 待办"
      }
    ],
    "settings": [
      {
        "key": "workspaceId",
        "title": "TAPD 项目 ID",
        "type": "string",
        "placeholder": "12345678"
      },
      {
        "key": "owner",
        "title": "负责人",
        "type": "string",
        "description": "按 TAPD「当前处理人」精确匹配，支持多人时用分号分隔"
      },
      {
        "key": "onlyOpen",
        "title": "只显示未关闭",
        "type": "boolean",
        "default": true
      },
      {
        "key": "limit",
        "title": "最多条数",
        "type": "integer",
        "default": 100,
        "minimum": 1,
        "maximum": 200
      },
      {
        "key": "pollMinutes",
        "title": "状态栏轮询间隔（分钟）",
        "type": "integer",
        "default": 5,
        "minimum": 1,
        "maximum": 60
      },
      {
        "key": "dispatchWorkspace",
        "title": "默认派单工作区（可选）",
        "type": "string",
        "placeholder": "path:/root/projects/your-repo",
        "description": "详情页选择的工作区会按 TAPD 项目记住，并覆盖此默认值"
      },
      {
        "key": "dispatchAgent",
        "title": "派单 Agent",
        "type": "string",
        "default": "claude",
        "description": "已安装的 Orca agent 名称，如 claude、codex、omp"
      },
      {
        "key": "dispatchModel",
        "title": "派单模型（可空）",
        "type": "string",
        "description": "可选，传给 `orca agent launch --model`"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "secrets:own"
    },
    {
      "kind": "settings:own"
    },
    {
      "kind": "workspace:read"
    }
  ],
  "license": "MIT",
  "author": {
    "name": "Morin Li",
    "url": "https://github.com/li363920783"
  },
  "repository": "https://github.com/li363920783/orca-tapd-todo"
}
